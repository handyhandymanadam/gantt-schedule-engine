{
  "name": "gantt-schedule-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Reference Gantt chart renderer for gantt-schedule-engine. Vanilla JS, neutral default styling, no dependencies.",
  "license": "MIT",
  "author": "handyhandymanadam <handyhandyman.adam@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handyhandymanadam/gantt-schedule-engine.git",
    "directory": "packages/gantt-ui"
  },
  "homepage": "https://github.com/handyhandymanadam/gantt-schedule-engine#readme",
  "bugs": { "url": "https://github.com/handyhandymanadam/gantt-schedule-engine/issues" },
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./theme.css": "./src/theme.css"
  },
  "files": ["dist", "src/theme.css", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "dependencies": {
    "gantt-schedule-engine": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b && cp src/theme.css dist/theme.css"
  }
}
